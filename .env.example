# Copy to .env (same folder) to run the pipeline live: cp .env.example .env
# .env is git-ignored. The key is never printed or logged.

# Your OpenRouter key (https://openrouter.ai/keys). Needed only for live runs: make live, make live-all, uploads.
OPENROUTER_API_KEY=

# Optional: stop before any paid call once this key's total usage reaches this many US dollars (default 7).
# TCCC_BUDGET_USD=7

# Optional: the second listen. Leave commented to keep it on (recommended). Set it to an empty value in your
# shell (export TCCC_SECOND=) to turn it off.
# TCCC_SECOND=qwen__qwen3.8-omni-flash
